{
  "name": "@k2net/auth",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Keycloak OIDC (SPA) and NextAuth configuration for K2NET portals",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "keycloak-js": "^26.0.0",
    "next-auth": "5.0.0-beta.30",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5.0.0"
  }
}
