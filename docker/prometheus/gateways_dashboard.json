      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(gateway_http_requests_total[1m])) by (application)",
          "legendFormat": "{{application}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API Throughput (Requests Rate)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 10,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gateway_http_request_duration_seconds_bucket[5m])) by (le, application))",
          "legendFormat": "{{application}} (p95)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Latency (p95 Percentile)",
      "type": "timeseries"
