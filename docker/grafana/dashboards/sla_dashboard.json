          "expr": "sum(rate(http_server_requests_seconds_bucket{le=\"0.5\",job=~\".*backend.*|spring-boot\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\".*backend.*|spring-boot\"}[5m])) * 100",
