# Security Credentials for FTTH GIS Docker Compose Stack
DB_USER=your_postgres_user
DB_PASSWORD=your_db_password
DB_NAME=your_postgres_database
KC_ADMIN_USER=your_keycloak_admin_username
KC_ADMIN_PASSWORD=your_keycloak_admin_password
KC_DB_NAME=your_keycloak_database
GRAFANA_USER=your_grafana_admin_username
GRAFANA_PASSWORD=your_grafana_admin_password
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Google OAuth Credentials (Google IDP)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth Credentials (GitHub IDP)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Keycloak Client Credentials
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
AUTH_KEYCLOAK_SECRET=your_auth_keycloak_secret

# Gateway Communication Token
GATEWAY_TOKEN=your_gateway_communication_token

# NextAuth Secret
AUTH_SECRET=your_nextauth_secret

FRONTEND_URL=your_frontend_url
APP_DEVOPS_GITHUB_WEBHOOK_SECRET=your_webhook_secret

# MinIO / S3 Credentials
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
MINIO_KMS_SECRET_KEY=your_minio_kms_secret_key

# AI Assistant Gateway (gateway-ai :5012)
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
DEFAULT_LLM_PROVIDER=openai

# Cloudflare Turnstile Anti-Bot Security (gateway-auth :5014 & Frontend React UI)
TURNSTILE_SECRET_KEY=0x4AAAAAA...your_cloudflare_secret_key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...your_cloudflare_site_key
TURNSTILE_TENANT_SECRET_KEY=0x4AAAAAA...your_tenant_secret_key
VITE_TURNSTILE_TENANT_SITE_KEY=0x4AAAAAA...your_tenant_site_key
