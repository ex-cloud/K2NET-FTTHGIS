# K2NET FTTH AI Gateway — Environment Variables Template
# Salin file ini menjadi .env dan isi nilai yang sesuai

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5012
LOG_LEVEL=INFO
ENVIRONMENT=production

# ─── Database (PostgreSQL 17 + pgvector) ─────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://ftth_user:CHANGE_ME@ftth-postgres:5432/ftth_gis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ─── Internal Security (Kong Shared Token) ───────────────────────────────────
# Harus sama persis dengan nilai ${GATEWAY_INTERNAL_TOKEN} di Kong
GATEWAY_INTERNAL_TOKEN=CHANGE_ME_STRONG_SECRET

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Pilih salah satu: openai | gemini
DEFAULT_LLM_PROVIDER=openai

# OpenAI Configuration (jika DEFAULT_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini Configuration (jika DEFAULT_LLM_PROVIDER=gemini)
GEMINI_API_KEY=CHANGE_ME
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash

# ─── RAG Configuration ───────────────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_RETRIEVAL_LIMIT=4
EMBEDDING_DIMENSION=1536

# ─── CORS (Frontend Origins) ─────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://system-gis.kdua.net","https://gis.kdua.net"]
